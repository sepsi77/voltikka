# Kamal reads the secret values from Google Cloud Secret Manager at deploy time.
# This file holds only commands, never values, so it is safe to commit.
# Needs: gcloud CLI logged in as seppo@breezily.fi with access to the project below.
SECRETS=$(kamal secrets fetch --adapter gcp --account seppo@breezily.fi --from breezily-infra voltikka-ghcr-read-token voltikka-temporal-api-key voltikka-app-key voltikka-mysql-password voltikka-mysql-root-password voltikka-entsoe-api-key voltikka-fingrid-api-key voltikka-gie-api-key voltikka-openrouter-api-key voltikka-digitransit-api-key voltikka-sentry-laravel-dsn)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract voltikka-ghcr-read-token $SECRETS)
TEMPORAL_API_KEY=$(kamal secrets extract voltikka-temporal-api-key $SECRETS)
APP_KEY=$(kamal secrets extract voltikka-app-key $SECRETS)
MYSQL_PASSWORD=$(kamal secrets extract voltikka-mysql-password $SECRETS)
MYSQL_ROOT_PASSWORD=$(kamal secrets extract voltikka-mysql-root-password $SECRETS)
DB_PASSWORD=$MYSQL_PASSWORD
ENTSOE_API_KEY=$(kamal secrets extract voltikka-entsoe-api-key $SECRETS)
FINGRID_API_KEY=$(kamal secrets extract voltikka-fingrid-api-key $SECRETS)
GIE_API_KEY=$(kamal secrets extract voltikka-gie-api-key $SECRETS)
OPENROUTER_API_KEY=$(kamal secrets extract voltikka-openrouter-api-key $SECRETS)
DIGITRANSIT_API_KEY=$(kamal secrets extract voltikka-digitransit-api-key $SECRETS)
SENTRY_LARAVEL_DSN=$(kamal secrets extract voltikka-sentry-laravel-dsn $SECRETS)
