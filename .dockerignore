# Docker build context for the production image (Dockerfile at the repository root).
#
# Primary protection: scripts/build-and-push-image.sh builds from a clean `git archive`
# export of the committed HEAD, so untracked and ignored local files never reach the image.
# This file is the second layer. It keeps an ad-hoc `docker build .` from the working tree
# away from local secrets and data (laravel/.env, the 2 GB local SQLite copy of production
# data, sessions, file cache, imports, logs, vendor, node_modules) and keeps the large
# design/, tasks/, media/, videos/ and legacy/ trees out of the upload.
#
# Allowlist: only the COPY sources of the Dockerfile. Add a path here when the Dockerfile
# copies a new one.
*
!Dockerfile
!docker-entrypoint.sh
!supervisord.conf
!laravel
!remotion

# Mirrors laravel/.gitignore and the nested storage/.gitignore files.
**/.DS_Store
**/node_modules
laravel/.env
laravel/.env.backup
laravel/.env.production
laravel/.phpunit.cache
laravel/.phpunit.result.cache
laravel/vendor
laravel/auth.json
laravel/database/*.sqlite*
laravel/bootstrap/cache/*
!laravel/bootstrap/cache/.gitignore
laravel/storage/**
!laravel/storage/**/.gitignore
laravel/public/build
laravel/public/hot
laravel/public/storage
laravel/public/sitemap.xml
laravel/public/css/filament
laravel/public/fonts/filament
laravel/public/js/filament
laravel/data-investigation/price-forecasting/outputs/*
!laravel/data-investigation/price-forecasting/outputs/.gitignore

# Mirrors remotion/.gitignore and the root build/ rule.
remotion/build
remotion/dist
remotion/out
remotion/.env
