<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <!-- Canonical pricing defaults off in tests; tests that exercise it opt in via config()->set().
             Both flags are pinned with force="true" so the suite cannot inherit a developer's .env:
             both are true in production, so an unpinned flag makes results depend on whose machine
             ran them. -->
        <env name="CANONICAL_PRICING_ENABLED" value="false" force="true"/>
        <env name="RESET_FORWARD_SHIFT_ENABLED" value="false" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="LOG_CHANNEL" value="stack" force="true"/>
        <env name="LOG_STACK" value="single" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SENTRY_ENABLE_LOGS" value="(false)" force="true"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="SENTRY_PROFILES_SAMPLE_RATE" value="0.0" force="true"/>
        <env name="SENTRY_PROFILE_CONSOLE_ENABLED" value="false" force="true"/>
        <env name="SENTRY_PROFILE_QUEUE_ENABLED" value="false" force="true"/>
        <env name="SENTRY_TRACES_SAMPLE_RATE" value="0.0" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
