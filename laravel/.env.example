APP_NAME=Voltikka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Helsinki
APP_URL=http://localhost

APP_LOCALE=fi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fi_FI

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Add sentry_logs to the stack in production if SENTRY_ENABLE_LOGS=true.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=
# Keep performance tracing/profiling disabled unless actively investigating performance.
# Error capture and sentry_logs forwarding do not require sampled spans.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_PROFILE_CONSOLE_ENABLED=false
SENTRY_PROFILE_QUEUE_ENABLED=false
SENTRY_ENABLE_LOGS=false
SENTRY_LOG_LEVEL=info

# PostgreSQL on Google Cloud SQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voltikka
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=450

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Spatie Laravel Backup. Production uses a Railway S3-compatible bucket.
BACKUP_NAME=Voltikka
BACKUP_DISK=s3
BACKUP_FILENAME_PREFIX=voltikka-
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_MAX_STORAGE_MB=10000

VITE_APP_NAME="${APP_NAME}"

# ENTSO-E Transparency Platform API (spot prices)
# Get your key at https://transparency.entsoe.eu/
ENTSOE_API_KEY=

# Optional third-party spot price forecast feed for MVP forecast display
NORDPOOL_PREDICT_FI_URL=https://raw.githubusercontent.com/vividfog/nordpool-predict-fi/main/deploy/prediction.json
NORDPOOL_PREDICT_FI_VAT_RATE=0.255
NORDPOOL_PREDICT_FI_CONNECT_TIMEOUT=5
NORDPOOL_PREDICT_FI_TIMEOUT=15
NORDPOOL_PREDICT_FI_RETRY_ATTEMPTS=3
NORDPOOL_PREDICT_FI_RETRY_DELAY_MS=1000

# Digitransit API (geocoding for solar calculator)
# Get your key at https://digitransit.fi/en/developers/api-registration/
DIGITRANSIT_API_KEY=

# Anthropic API (for social media text generation)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter API (for LLM access - used for social media text generation)
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Automated contract interpretation and canonical publication
CONTRACT_INTERPRETATION_ENABLED=false
CONTRACT_INTERPRETATION_MODEL=openai/gpt-5.6-luna
CONTRACT_INTERPRETATION_REASONING_EFFORT=medium
CONTRACT_INTERPRETATION_MAX_TOKENS=6000
CONTRACT_INTERPRETATION_CONNECT_TIMEOUT=10
CONTRACT_INTERPRETATION_TIMEOUT=120
CONTRACT_INTERPRETATION_MAX_REPAIR_ATTEMPTS=2
CONTRACT_INTERPRETATION_QUEUE=default

# PostFast API (for social media scheduling to TikTok, Instagram, YouTube, X)
# Get your API key at https://postfa.st/
POSTFAST_API_KEY=
# Keep false by default. Set true explicitly in production to enable daily Spot posting.
SPOT_SOCIAL_PUBLISHING_ENABLED=false

# Remotion video rendering paths (defaults work in Docker)
# REMOTION_PATH=/app/remotion
# REMOTION_OUTPUT_DIR=/app/storage/app/videos

# Canonical phase-aware pricing. Both config defaults are FALSE, and both are TRUE in
# production, so a local environment that omits them silently prices contracts differently
# from the live site. See laravel/app/Services/CanonicalPricing/AGENTS.md.
CANONICAL_PRICING_ENABLED=true
# Annualises market-reset products (kvartaalisähkö, markkinahintasähkö) with an FI
# forward-curve shift instead of holding the current period's price flat for 12 months.
RESET_FORWARD_SHIFT_ENABLED=true
